<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Money Receipt</title>
  <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

</head>
<style>
  @page {
    margin: 20px 25px 20px 25px;
  }

  @page: first {
    margin-top: 0;
  }

  body {
    font-family: 'Arial', sans-serif;
    margin: 0;
    padding: 0;
  }

  .receivedBtn {
    background: #82017f;
    color: #fff;
    width: 180px;
    height: 30px;
    border-radius: 20px;
    margin: auto;

  }
</style>

<body>
  <div>
    <div
      style="display: flex; align-items: center; justify-content: space-between; flex-direction: row; gap: 3px; align-items: center ;">
      <div style="display: flex; align-items: center; justify-content: space-between;  margin-bottom: 8px;">
        <img style="width: 100px; height: 100px; object-fit: contain;" src="<%= companyData.logo %>"
          alt="<%= companyData.companyName || 'Company Logo' %>">

      </div>

      <div style="width: 570px; text-align: center; color: #0950a1;">
        <div style="display:flex ; justify-content:center; align-items:center;flex-direction: column;">


          <% if (companyData?.companyNameBN) { %>
            <span style="font-size: 40px; font-family: 'Hind Siliguri', sans-serif; display: block ;">
              <%= companyData?.companyNameBN %>
            </span>
            <% } %>


              <% if (companyData?.companyName) { %>
                <b style=" font-size: 18px; color: #333; display: block;">
                  (<%= companyData?.companyName %>)
                </b>
                <% } %>


        </div>
        <small style="margin-top: -20px;">
          <%= companyData.address%>
        </small>
      </div>


      <div style="display: flex; flex-direction: column; gap: 3px; margin-top: 30px;">
        <div style="display: flex; align-items: center; gap: 5px;">
          <i class="fa-solid fa-phone"></i>
          <small>+880 1821-216465</small>
        </div>
        <div style="display: flex; align-items: center; gap: 5px;">
          <i class="fa-solid fa-phone"></i>
          <small>
            <%= companyData?.phone %>
          </small>
        </div>
        <div style="display: flex; align-items: center; gap: 5px;">
          <i class="fa-solid fa-envelope"></i>
          <small>
            <%= companyData?.email %>
          </small>
        </div>
      </div>

    </div>

    <div style=" display: flex;justify-content: center; align-items: center; width:100%">
      <button class="receivedBtn">Money Receipt</button>
    </div>

    <div style="display: flex; justify-content: space-between; font-style: italic;">
      <small>Money receipt ID: <%= money && money.moneyReceiptId ? money.moneyReceiptId : 'N/A' %> </small>
      <small>Date: <%= money && money.default_date ? money.default_date : 'N/A' %> </small>
    </div>


    <div>
      <div style="display: flex; margin-top:10px ">
        <small style="width: 210px; font-style: italic; font-style: italic ;">
          Received with thanks from
        </small>
        <span style="font-size: small;font-style: italic; border-bottom: 1px dashed #81027e; width:100%;">
          <%= money && money.thanks_from ? money.thanks_from : 'N/A' %>
        </span>
      </div>

      <div style="display: flex; align-items: center; margin-top:20px; width:100% ; gap:10px ">
        <div style="display: flex; align-items: center; width:50% ">
          <small style="font-style: italic; width:350px">
            <% if (money && money.against_bill_no_method) { %>
              <% if (money.against_bill_no_method==='Final payment against bill no' ) { %>
                <%= 'Final payment against bill no' %>
                  <% } else if (money.against_bill_no_method==='Advance against bill no' ) { %>
                    <%= 'Advance against bill no' %>
                      <% } else { %>
                        <%= money.against_bill_no_method %>
                          <% } %>
                            <% } else { %>
                              N/A
                              <% } %> :
          </small>
          <span style="font-size: small;font-style: italic; border-bottom: 1px dashed #81027e; width:100%">
            <%= money && money.job_no ? money.job_no : 'N/A' %>
          </span>
        </div>
        <div style="display: flex; align-items: center;width:50% ">
          <small style="font-style: italic;width:90px ">Vehicle No :</small>
          <span style="font-size: small;font-style: italic; border-bottom: 1px dashed #81027e; width:100% ">
            <%= money && money?.vehicle?.fullRegNum ? money?.vehicle?.fullRegNum : 'N/A' %>
          </span>
        </div>
      </div>
      <div style="display: flex; align-items: center; margin-top:20px; width:100% ;gap:10px">
        <div style="display: flex; align-items: center; width:100% ">
          <small style="font-style: italic; width:150px">Payment Method :</small>
          <span style="font-size: small;font-style: italic; border-bottom: 1px dashed #81027e; width:100%">
            <% if (money && money.payment_method) { %>
              <% if (money.payment_method==='Bkash' ) { %>
                <%= 'Bkash' %>
                  <% } else if (money.payment_method==='Nagad' ) { %>
                    <%= 'Nagad' %>

                      <% } else if (money.payment_method==='Rocket' ) { %>
                        <%= 'Rocket' %>

                          <% } else if (money.payment_method==='Cash' ) { %>
                            <%= 'Cash' %>

                              <% }else if (money.payment_method==='Check' ) { %>
                                <%= 'Check' %>

                                  <% }else if (money.payment_method==='Bank Transfer' ) { %>
                                    <%= 'Bank Transfer' %>

                                      <% } else { %>
                                        <%= money.payment_method %>
                                          <% } %>
                                            <% } else { %>
                                              N/A
                                              <% } %>
          </span>
        </div>
        <% if (money && money.default_date) { %>
          <div style="display: flex; align-items: center; width:50%">
            <small style="font-style: italic; width:50px">Date :</small>
            <span style="font-size: small; font-style: italic; border-bottom: 1px dashed #81027e; width:100%">
              <%= new Date(money.default_date).toLocaleDateString('en-GB') %>
                <!-- Formats as day/month/year -->
            </span>
          </div>
          <% } %>



      </div>
      <div style="display: flex; align-items: center;  width:100% ;gap:10px">
        <% if (money && money.account_number) { %>
          <div style="display: flex; margin-top:20px; align-items: center; width:50% ">
            <small style="font-style: italic; width:160px">Account Number :</small>
            <span style="font-size: small; font-style: italic; border-bottom: 1px dashed #81027e; width:100%">
              <%= money.account_number %>
            </span>
          </div>
          <% } %>

            <% if (money && money.transaction_id) { %>
              <div style="display: flex;  margin-top:20px; align-items: center; width:50% ">
                <small style="font-style: italic; width:120px">Transition ID :</small>
                <span style="font-size: small; font-style: italic; border-bottom: 1px dashed #81027e; width:100%">
                  <%= money && money.transaction_id %>
                </span>
              </div>
              <% } %>
      </div>
      <div style="display: flex; align-items: center; width:100% ;gap:10px">
        <% if (money && money.cash_by) { %>
          <div style="display: flex;  margin-top:20px; align-items: center; width:50% ">
            <small style="font-style: italic; width:120px">Cash By :</small>
            <span style="font-size: small; font-style: italic; border-bottom: 1px dashed #81027e; width:100%">
              <%= money && money.cash_by %>
            </span>
          </div>
          <% } %>
      </div>
      <div style="display: flex; align-items: center; width:100% ;gap:10px">

        <% if (money && money.check_number) { %>
          <div style="display: flex;  margin-top:20px; align-items: center; width:50% ">
            <small style="font-style: italic; width:140px">Check Number :</small>
            <span style="font-size: small; font-style: italic; border-bottom: 1px dashed #81027e; width:100%">
              <%= money && money.check_number %>
            </span>
          </div>
          <% } %>

            <% if (money && money.bank_name) { %>
              <div style="display: flex;  margin-top:20px; align-items: center; width:50% ">
                <small style="font-style: italic; width:120px">Bank Name :</small>
                <span style="font-size: small; font-style: italic; border-bottom: 1px dashed #81027e; width:100%">
                  <%= money && money.bank_name %>
                </span>
              </div>
              <% } %>



      </div>


      <div style="display: flex; align-items: center; width:100% ;gap:10px">

        <% if (money && money.check_date && money.check_date !=='NaN-NaN-NaN' ) { %>
          <div style="display: flex;  margin-top:20px; align-items: center; width:50% ">
            <small style="font-style: italic; width:120px">Check Date :</small>
            <span style="font-size: small; font-style: italic; border-bottom: 1px dashed #81027e; width:100%">
              <%= money && money.check_date%>
            </span>
          </div>
          <% } %>



            <% if (money && money.payment_date && money.payment_date !=='NaN-NaN-NaN' ) { %>
              <div style="display: flex;  margin-top:20px; align-items: center; width:50% ">
                <small style="font-style: italic; width:140px">Payment Date :</small>
                <span style="font-size: small; font-style: italic; border-bottom: 1px dashed #81027e; width:100%">
                  <%= money && money.payment_date %>
                </span>
              </div>
              <% } %>


      </div>


      <div style="margin-top: 20px; display: flex; align-items: center;gap: 30px;">
        <div style="display: flex; align-items: center; justify-content: center;">
          <small style="width: 120px;font-style: italic;">Total Amount Tk :</small>
          <span style="font-weight: bold; font-style: italic; font-size:12px">
            <%= money && money.total_amount ? formatToIndianCurrency(money.total_amount) : 'N/A' %>
          </span>
        </div>


        <% if (money && money.advance) { %>
          <div style="width: 130px; display: flex; align-items: center; justify-content: space-between;">
            <small style="font-style: italic;">
              <%= money.total_amount===money.advance ? "Paid" : "Advance" %> :
            </small>
            <span style="font-style: italic; font-size:12px; font-weight: bold;">
              <%= formatToIndianCurrency(money.advance) %>
            </span>
          </div>
          <% } %>


            <% if (money && money.remaining) { %>
              <div style="width: 120px; display: flex; align-items: center; justify-content: space-between;">
                <small style="font-style: italic;">
                  <%= money && money.against_bill_no_method==='Final payment against bill no' ? 'Paid' : 'Remaining' %>
                </small> :
                <span style="font-style: italic; font-size:12px; font-weight: bold;">
                  <%= money && formatToIndianCurrency(money.remaining) %>
                </span>
              </div>
              <% } %>

      </div>

      <div style="margin-top:20px; display: flex; align-items: center; justify-content: center;">
        <small style="font-style: italic;width:110px; font-style: italic;">In words (taka):</small>
        <span style="font-size: 12px; width: 100%; border-bottom: 1px dashed #81027e; font-style: italic;">
          <%= money && money. total_amount_in_words ? money. total_amount_in_words : 'N/A' %>
        </span>
      </div>

    </div>

    <div style="display: flex; justify-content: space-between; margin-top: 64px; margin-bottom: 20px; font-size: 12px;">
      <div style="text-align: center;">
        <div style="border-top: 1px solid black; padding-top: 4px; margin: 0 auto; width: 192px;">
          Client Signature
        </div>
      </div>
      <div style="text-align: center;">
        <div style="border-top: 1px solid black; padding-top: 4px; margin: 0 auto; width: 192px;">
          Authorized Signature
        </div>
      </div>
    </div>
  </div>
</body>

</html>